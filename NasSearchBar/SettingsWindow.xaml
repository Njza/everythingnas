<Window x:Class="NasSearchBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NAS 搜索设置" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Surface}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        Foreground="{StaticResource Primary}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <!-- one look for TextBox and PasswordBox: both host their text in PART_ContentHost -->
        <ControlTemplate x:Key="InputTemplate" TargetType="Control">
            <Border x:Name="B" Height="36" Padding="8,0" CornerRadius="8" Background="{StaticResource Surface}"
                    BorderBrush="{StaticResource InputLine}" BorderThickness="1">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style TargetType="TextBox">
            <Setter Property="Template" Value="{StaticResource InputTemplate}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Template" Value="{StaticResource InputTemplate}" />
            <Setter Property="CaretBrush" Value="{StaticResource Accent}" />
            <Setter Property="SelectionBrush" Value="{StaticResource Accent}" />
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{StaticResource Surface}" BorderBrush="{StaticResource InputLine}" BorderThickness="1">
                                <Path x:Name="Tick" Data="M3.5,7 L6,9.5 L10.5,4.5" Stroke="White" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Primary}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Primary}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Primary}" />
            <Setter Property="Background" Value="{StaticResource Surface}" />
            <Setter Property="BorderBrush" Value="{StaticResource InputLine}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Padding="{TemplateBinding Padding}" CornerRadius="8" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Opacity" Value="0.86" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="Background" Value="{StaticResource Primary}" />
            <Setter Property="BorderBrush" Value="{StaticResource Primary}" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="服务器" Style="{StaticResource Heading}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="地址" Style="{StaticResource Label}" />
            <TextBox x:Name="AddressInput" Grid.Column="1" />
        </Grid>
        <TextBlock Style="{StaticResource Note}" Margin="56,8,0,0"
                   Text="NAS 在局域网里的地址加端口，如 192.168.1.10:8765" />

        <TextBlock Text="登录" Style="{StaticResource Heading}" Margin="0,24,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="账号" Style="{StaticResource Label}" />
            <TextBox x:Name="UserInput" Grid.Column="1" />
            <TextBlock Grid.Row="1" Text="密码" Style="{StaticResource Label}" Margin="0,12,0,0" />
            <PasswordBox x:Name="PassInput" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" />
        </Grid>
        <TextBlock Style="{StaticResource Note}" Margin="56,8,0,0"
                   Text="服务器设置了 AUTH 时填写。密码加密保存，只有当前 Windows 用户能读取" />

        <TextBlock Text="快捷键" Style="{StaticResource Heading}" Margin="0,24,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="呼出" Style="{StaticResource Label}" />
            <TextBox x:Name="HotkeyInput" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     FontFamily="{StaticResource Mono}" FontSize="13" Cursor="Hand"
                     PreviewKeyDown="Hotkey_PreviewKeyDown" />
        </Grid>
        <TextBlock Style="{StaticResource Note}" Margin="56,8,0,0"
                   Text="点输入框，再按新的组合键。要带 Ctrl、Alt 或 Win" />

        <TextBlock Text="打开文件" Style="{StaticResource Heading}" Margin="0,24,0,12" />
        <CheckBox x:Name="UseDrives" Content="用映射的网络驱动器打开，如 Z:" />
        <TextBlock Style="{StaticResource Note}" Margin="24,8,0,0"
                   Text="按共享名匹配已映射的盘符；没映射的共享照常用 \\NAS\共享 路径" />

        <DockPanel Margin="0,32,0,0">
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="保存" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            <Button DockPanel.Dock="Right" Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" />
            <Button x:Name="TestButton" DockPanel.Dock="Right" Content="测试连接"
                    Style="{StaticResource SecondaryButton}" Click="Test_Click" />
            <TextBlock x:Name="Status" FontSize="12" Foreground="{StaticResource Secondary}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>
    </StackPanel>
</Window>
