<Window x:Class="NasSearchBar.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NAS 搜索设置" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource Surface}"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        Foreground="{DynamicResource Primary}" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">

    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource Field}">
            <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}" />
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="16,0" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
            <Setter Property="Background" Value="{DynamicResource Surface}" />
            <Setter Property="BorderBrush" Value="{DynamicResource InputLine}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" Padding="{TemplateBinding Padding}" CornerRadius="8" BorderThickness="1"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="B" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource Raised}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Foreground" Value="{DynamicResource OnPrimary}" />
            <Setter Property="Background" Value="{DynamicResource Primary}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Primary}" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PrimaryHover}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource PrimaryHover}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <StackPanel Margin="24">
        <TextBlock Text="服务器" Style="{StaticResource Heading}" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="地址" Style="{StaticResource Label}" />
            <TextBox x:Name="AddressInput" Grid.Column="1" />
        </Grid>
        <TextBlock Style="{StaticResource Note}" Margin="56,8,0,0"
                   Text="NAS 的局域网地址加端口，如 192.168.1.10:8765&#10;不填就只搜本机硬盘" />

        <TextBlock Text="登录" Style="{StaticResource Heading}" Margin="0,24,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="账号" Style="{StaticResource Label}" />
            <TextBox x:Name="UserInput" Grid.Column="1" />
            <TextBlock Grid.Row="1" Text="密码" Style="{StaticResource Label}" Margin="0,12,0,0" />
            <PasswordBox x:Name="PassInput" Grid.Row="1" Grid.Column="1" Margin="0,12,0,0" />
        </Grid>
        <TextBlock Style="{StaticResource Note}" Margin="56,8,0,0"
                   Text="NAS 端设置了 AUTH 时才填&#10;密码加密保存，只有当前 Windows 用户能读取" />

        <TextBlock Text="快捷键" Style="{StaticResource Heading}" Margin="0,24,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="56" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="呼出" Style="{StaticResource Label}" />
            <TextBox x:Name="HotkeyInput" Grid.Column="1" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     FontFamily="{StaticResource Mono}" FontSize="13" Cursor="Hand"
                     PreviewKeyDown="Hotkey_PreviewKeyDown" />
        </Grid>
        <TextBlock Style="{StaticResource Note}" Margin="56,8,0,0"
                   Text="点输入框，再按新的组合键。要带 Ctrl、Alt 或 Win" />

        <TextBlock Text="启动" Style="{StaticResource Heading}" Margin="0,24,0,12" />
        <CheckBox x:Name="AutoStartBox" Content="开机自动启动" />
        <TextBlock Style="{StaticResource Note}" Margin="24,8,0,0"
                   Text="登录 Windows 后显示在桌面" />

        <DockPanel Margin="0,32,0,0">
            <Button x:Name="SaveButton" DockPanel.Dock="Right" Content="保存" IsDefault="True"
                    Style="{StaticResource PrimaryButton}" Click="Save_Click" />
            <Button DockPanel.Dock="Right" Content="取消" IsCancel="True" Style="{StaticResource SecondaryButton}" />
            <Button x:Name="TestButton" DockPanel.Dock="Right" Content="测试连接"
                    Style="{StaticResource SecondaryButton}" Click="Test_Click" />
            <TextBlock x:Name="Status" FontSize="12" Foreground="{DynamicResource Secondary}"
                       VerticalAlignment="Center" TextWrapping="Wrap" />
        </DockPanel>

        <TextBlock x:Name="VersionText" Style="{StaticResource Note}" Margin="0,16,0,0" />
    </StackPanel>
</Window>
