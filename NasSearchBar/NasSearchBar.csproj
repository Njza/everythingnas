<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- only for the tray icon (NotifyIcon) -->
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- lets the SDK build this on macOS/Linux too -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- uses the installed .NET Desktop Runtime: a 0.3 MB exe instead of 72 MB with the runtime bundled.
         A PC without it gets Windows' prompt with the download link on first start. -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- also runs on a newer major (.NET 11...) when 10 is not installed -->
    <RollForward>Major</RollForward>
    <AssemblyName>NasSearch</AssemblyName>
    <!-- bump on every release build; shows in the settings window and the exe's file properties -->
    <Version>1.5.0</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- symbols inside the exe: crash traces keep file and line, and dist holds just the one file -->
    <DebugType>embedded</DebugType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <!-- WFO0003 wants WinForms' SetHighDpiMode; this is a WPF app, where the manifest is the way to set DPI awareness -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- the tray loads the same icon as the exe -->
    <Resource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- WinForms global usings clash with WPF names (Application, MessageBox, Color...) -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
