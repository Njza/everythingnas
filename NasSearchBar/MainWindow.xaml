<Window x:Class="NasSearchBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="NAS 搜索" Width="728" SizeToContent="Height"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI" FontSize="14"
        TextOptions.TextFormattingMode="Display"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Hover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Secondary}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Height="52" Padding="8,0" CornerRadius="8"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Hairline}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- lucide "pin", 16px: shows on hover or selection, stays visible and filled once pinned -->
        <Style x:Key="PinButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="置顶  Ctrl+D" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="6" Background="Transparent">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="Icon" Stroke="{StaticResource Muted}" StrokeThickness="2.25" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M12,17 V22 M5,17 H19 V15.24 A2,2 0 0 0 17.89,13.45 L16.11,12.55 A2,2 0 0 1 15,10.76 V6 H16 A2,2 0 0 0 16,2 H8 A2,2 0 0 0 8,6 H9 V10.76 A2,2 0 0 1 7.89,12.55 L6.11,13.45 A2,2 0 0 0 5,15.24 Z" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Secondary}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0F171717" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="ToolTip" Value="取消置顶  Ctrl+D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="48" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- file-type tag, colored by the app that opens it -->
                <Border Width="40" Height="20" CornerRadius="4" Margin="0,0,0,16" HorizontalAlignment="Left">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#0F171717" />
                            <Setter Property="TextElement.Foreground" Value="#525252" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding App}" Value="word">
                                    <Setter Property="Background" Value="#1F2B579A" />
                                    <Setter Property="TextElement.Foreground" Value="#2B579A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding App}" Value="excel">
                                    <Setter Property="Background" Value="#1F217346" />
                                    <Setter Property="TextElement.Foreground" Value="#217346" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding App}" Value="powerpoint">
                                    <Setter Property="Background" Value="#1FA53F25" />
                                    <Setter Property="TextElement.Foreground" Value="#A53F25" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding App}" Value="pdf">
                                    <Setter Property="Background" Value="#1FC42B1C" />
                                    <Setter Property="TextElement.Foreground" Value="#C42B1C" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding Kind}" FontFamily="{StaticResource Mono}" FontSize="11"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Name}" Height="20" Foreground="{StaticResource Primary}"
                               TextTrimming="CharacterEllipsis" />
                    <DockPanel Height="16">
                        <!-- share name, like the label on a filing-cabinet drawer -->
                        <Border DockPanel.Dock="Left" Margin="0,0,8,0" Padding="4,0"
                                CornerRadius="4" BorderBrush="{StaticResource Hairline}" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Share}" Value="">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Text="{Binding Share}" FontFamily="{StaticResource Mono}" FontSize="11"
                                       Foreground="{StaticResource Secondary}" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="{Binding Folder}" FontSize="12" Foreground="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="12,0,0,0">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <!-- a pin keeps the size and date from when it was pinned, so they would be stale -->
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="pins">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding SizeText}" Height="20" HorizontalAlignment="Right" FontFamily="{StaticResource Mono}"
                               FontSize="12" Foreground="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding DateText}" Height="16" HorizontalAlignment="Right" FontSize="12"
                               Foreground="{StaticResource Muted}" />
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource PinButton}" Click="Pin_Click" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <!-- outer margin leaves room for the shadow -->
    <Grid Margin="24,16,24,32">
        <!-- shadow on its own layer so the text above keeps crisp rendering -->
        <Border CornerRadius="16" Background="{StaticResource Surface}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.12" Color="#000000" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="16" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource Hairline}" BorderThickness="1">
            <StackPanel>
                <Grid Height="56" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- lucide "search", 18px, stroke 1.5 -->
                    <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{StaticResource Muted}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M11,3 A8,8 0 1 1 11,19 A8,8 0 1 1 11,3 Z M21,21 L16.65,16.65" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="搜索 NAS" FontSize="18" Margin="3,0,0,0"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="Query" Grid.Column="1" FontSize="18" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Primary}"
                             CaretBrush="{StaticResource Accent}" SelectionBrush="{StaticResource Accent}"
                             TextChanged="Query_TextChanged" />
                    <TextBlock x:Name="Status" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"
                               FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Muted}" />
                </Grid>

                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                    <Border Height="1" Background="{StaticResource Hairline}" />
                    <ListBox x:Name="Results" MaxHeight="432" Padding="8" Focusable="False"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ItemContainerStyle="{StaticResource Row}" ItemTemplate="{StaticResource RowTemplate}"
                             PreviewMouseLeftButtonUp="Results_Click" />
                    <Border Height="1" Background="{StaticResource Hairline}" />
                    <StackPanel Orientation="Horizontal" Height="36" Margin="16,0">
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="打开" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+Enter" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="打开所在文件夹" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+D" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="置顶" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="关闭" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
