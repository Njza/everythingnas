<Window x:Class="NasSearchBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:NasSearchBar"
        Title="NAS 搜索" Width="680" SizeToContent="Height"
        Background="{DynamicResource Surface}" Foreground="{DynamicResource Primary}"
        ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- An opaque window keeps ClearType (a transparent one falls back to blurry grey text).
         The chrome hides the title bar but keeps the Windows frame, which draws the shadow and, on Windows 11, the round corners. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource Hover}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource Secondary}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Height="52" Padding="8,0" CornerRadius="8"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource Hairline}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- lucide "pin", 16px: shows on hover or selection, stays visible and filled once pinned -->
        <Style x:Key="PinButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="置顶  Ctrl+D" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="6" Background="Transparent">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="Icon" Stroke="{DynamicResource Muted}" StrokeThickness="2.25" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M12,17 V22 M5,17 H19 V15.24 A2,2 0 0 0 17.89,13.45 L16.11,12.55 A2,2 0 0 1 15,10.76 V6 H16 A2,2 0 0 0 16,2 H8 A2,2 0 0 0 8,6 H9 V10.76 A2,2 0 0 1 7.89,12.55 L6.11,13.45 A2,2 0 0 0 5,15.24 Z" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Secondary}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Secondary}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="{DynamicResource Raised}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="ToolTip" Value="取消置顶  Ctrl+D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <local:ShellIconConverter x:Key="ShellIcon" />

        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- the icon Explorer shows for this file type -->
                <Image Width="32" Height="32" HorizontalAlignment="Left" VerticalAlignment="Center"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Source="{Binding Converter={StaticResource ShellIcon}}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                               Foreground="{DynamicResource Primary}" TextTrimming="CharacterEllipsis" />
                    <!-- C:\Users\...\ trims when narrow; the folder holding the file always shows whole -->
                    <local:ShrinkFirstPanel Height="18" Margin="0,2,0,0" ToolTip="{Binding Location}" Background="Transparent">
                        <TextBlock Text="{Binding LocationOuter}" FontSize="12" Foreground="{DynamicResource Muted}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LocationInner}" FontSize="12" Foreground="{DynamicResource Secondary}"
                                   VerticalAlignment="Center" />
                    </local:ShrinkFirstPanel>
                </StackPanel>

                <!-- same line heights as the name and path, so size and date sit on their baselines -->
                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="72"
                            Typography.NumeralAlignment="Tabular">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <!-- a pin keeps the size and date from when it was pinned, so they would be stale -->
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="pins">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontSize="12"
                               LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Secondary}" />
                    <TextBlock Text="{Binding DateText}" HorizontalAlignment="Right" FontSize="12" Margin="0,2,0,0"
                               LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{DynamicResource Muted}" />
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource PinButton}" Click="Pin_Click" />
            </Grid>
        </DataTemplate>
    </Window.Resources>

            <StackPanel>
                <Grid Height="56" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- lucide "search", 18px, stroke 1.5 -->
                    <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{DynamicResource Muted}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M11,3 A8,8 0 1 1 11,19 A8,8 0 1 1 11,3 Z M21,21 L16.65,16.65" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="搜索文件" FontSize="18" Margin="3,0,0,0"
                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="Query" Grid.Column="1" FontSize="18" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0" Foreground="{DynamicResource Primary}"
                             CaretBrush="{DynamicResource Accent}" SelectionBrush="{DynamicResource Accent}"
                             TextChanged="Query_TextChanged" />
                    <TextBlock x:Name="Status" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"
                               FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{DynamicResource Muted}" />

                    <!-- lucide "funnel": pick the formats to search; blue while a filter is on -->
                    <Button x:Name="FilterButton" Grid.Column="3" Width="28" Height="28" Margin="8,0,-4,0"
                            Focusable="False" Cursor="Hand" ToolTip="只显示勾选的格式" Click="Filter_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="B" CornerRadius="6" Background="Transparent">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path x:Name="Icon" Stroke="{DynamicResource Muted}" StrokeThickness="2.25" Fill="Transparent"
                                                  StrokeLineJoin="Round" Data="M22,3 H2 L10,12.46 V19 L14,21 V12.46 Z" />
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="B" Property="Background" Value="{DynamicResource Raised}" />
                                        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Primary}" />
                                    </Trigger>
                                    <Trigger Property="Tag" Value="on">
                                        <Setter TargetName="Icon" Property="Stroke" Value="{DynamicResource Accent}" />
                                        <Setter TargetName="Icon" Property="Fill" Value="{DynamicResource Accent}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <!-- opaque, not AllowsTransparency, so its text keeps ClearType like the bar -->
                    <Popup x:Name="FilterPopup" PlacementTarget="{Binding ElementName=FilterButton}" Placement="Bottom"
                           HorizontalOffset="-216" VerticalOffset="12" StaysOpen="False" Opened="FilterPopup_Opened" Closed="FilterPopup_Closed">
                        <Border Width="244" Padding="12" Background="{DynamicResource Surface}"
                                BorderBrush="{DynamicResource InputLine}" BorderThickness="1">
                            <StackPanel>
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="全部显示" Focusable="False" Cursor="Hand"
                                            Click="FilterAll_Click">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontSize="12" Foreground="{DynamicResource Accent}" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                    <TextBlock Text="只显示勾选的格式" FontSize="12" Foreground="{DynamicResource Secondary}" />
                                </DockPanel>
                                <Grid Margin="0,12,0,0">
                                    <TextBox x:Name="FilterSearch" Style="{StaticResource Field}" Height="32" FontSize="13"
                                             CaretBrush="{DynamicResource Accent}" SelectionBrush="{DynamicResource Accent}"
                                             TextChanged="FilterSearch_TextChanged" />
                                    <!-- over the field (which paints its own surface), lined up with its text -->
                                    <TextBlock x:Name="FilterHint" Text="找格式，如 pdf" FontSize="13" Margin="11,0,0,0"
                                               Foreground="{DynamicResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                                </Grid>
                                <TextBlock x:Name="FilterStatus" FontSize="12" Margin="0,8,0,8" Foreground="{DynamicResource Muted}" />
                                <ListBox x:Name="FilterList" MaxHeight="320" Background="Transparent" BorderThickness="0"
                                         Focusable="False" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         VirtualizingPanel.IsVirtualizing="True">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Focusable" Value="False" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <ContentPresenter Margin="0,0,4,8" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat=N0}" FontSize="12"
                                                           Foreground="{DynamicResource Muted}" Typography.NumeralAlignment="Tabular" />
                                                <CheckBox IsChecked="{Binding On}" Content="{Binding Ext}" Focusable="False" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Button x:Name="RareButton" Focusable="False" Cursor="Hand" Margin="0,4,0,0"
                                        HorizontalAlignment="Left" Click="Rare_Click">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <TextBlock x:Name="T" Text="{TemplateBinding Content}" FontSize="12" Foreground="{DynamicResource Accent}" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="T" Property="TextDecorations" Value="Underline" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                    <Border Height="1" Background="{DynamicResource Hairline}" />
                    <ListBox x:Name="Results" MaxHeight="432" Padding="8" Focusable="False"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ItemContainerStyle="{StaticResource Row}" ItemTemplate="{StaticResource RowTemplate}"
                             PreviewMouseLeftButtonUp="Results_Click" PreviewMouseRightButtonUp="Results_RightClick" />
                    <Border Height="1" Background="{DynamicResource Hairline}" />
                    <StackPanel Orientation="Horizontal" Height="36" Margin="16,0">
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="打开" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+Enter" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="打开所在文件夹" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+D" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="置顶" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="清空" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
</Window>
