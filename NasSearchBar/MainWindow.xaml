<Window x:Class="NasSearchBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:NasSearchBar"
        Title="NAS 搜索" Width="680" SizeToContent="Height"
        Background="{StaticResource Surface}"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        FontFamily="Segoe UI, Microsoft YaHei UI" FontSize="14"
        TextOptions.TextFormattingMode="Display" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- An opaque window keeps ClearType (a transparent one falls back to blurry grey text).
         The chrome hides the title bar but keeps the Windows frame, which draws the shadow and, on Windows 11, the round corners. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="0,0,0,1" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="Keycap" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Hover}" />
            <Setter Property="BorderBrush" Value="{StaticResource Hairline}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="KeyText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource Mono}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Secondary}" />
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,16,0" />
        </Style>

        <Style x:Key="Row" TargetType="ListBoxItem">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Height="52" Padding="8,0" CornerRadius="8"
                                Background="Transparent" BorderBrush="Transparent" BorderThickness="1">
                            <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{StaticResource Raised}" />
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource Hairline}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- lucide "pin", 16px: shows on hover or selection, stays visible and filled once pinned -->
        <Style x:Key="PinButton" TargetType="Button">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="ToolTip" Value="置顶  Ctrl+D" />
            <Setter Property="Visibility" Value="Hidden" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="B" CornerRadius="6" Background="Transparent">
                            <Viewbox Width="16" Height="16">
                                <Canvas Width="24" Height="24">
                                    <Path x:Name="Icon" Stroke="{StaticResource Muted}" StrokeThickness="2.25" Fill="Transparent"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Data="M12,17 V22 M5,17 H19 V15.24 A2,2 0 0 0 17.89,13.45 L16.11,12.55 A2,2 0 0 1 15,10.76 V6 H16 A2,2 0 0 0 16,2 H8 A2,2 0 0 0 8,6 H9 V10.76 A2,2 0 0 1 7.89,12.55 L6.11,13.45 A2,2 0 0 0 5,15.24 Z" />
                                </Canvas>
                            </Viewbox>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="Icon" Property="Fill" Value="{StaticResource Secondary}" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Secondary}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#0F171717" />
                                <Setter TargetName="Icon" Property="Stroke" Value="{StaticResource Primary}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Pinned}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="ToolTip" Value="取消置顶  Ctrl+D" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="RowTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="44" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- the file itself: a sheet with a folded corner, tinted by the app that opens it; folders are manila -->
                <Grid x:Name="Doc" Width="28" Height="34" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Tag" Value="{StaticResource FileTint}" />
                            <Setter Property="TextElement.Foreground" Value="{StaticResource FileInk}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding App}" Value="word">
                                    <Setter Property="Tag" Value="{StaticResource WordTint}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource WordInk}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding App}" Value="excel">
                                    <Setter Property="Tag" Value="{StaticResource ExcelTint}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource ExcelInk}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding App}" Value="powerpoint">
                                    <Setter Property="Tag" Value="{StaticResource PowerPointTint}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource PowerPointInk}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding App}" Value="pdf">
                                    <Setter Property="Tag" Value="{StaticResource PdfTint}" />
                                    <Setter Property="TextElement.Foreground" Value="{StaticResource PdfInk}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <Grid x:Name="Sheet">
                        <Path Fill="{Binding Tag, ElementName=Doc}"
                              Data="M0.5,3.5 A3,3 0 0 1 3.5,0.5 H19.5 L27.5,8.5 V30.5 A3,3 0 0 1 24.5,33.5 H3.5 A3,3 0 0 1 0.5,30.5 Z" />
                        <Path Stroke="{Binding (TextElement.Foreground), ElementName=Doc}" StrokeThickness="1"
                              StrokeLineJoin="Round" Opacity="0.4"
                              Data="M0.5,3.5 A3,3 0 0 1 3.5,0.5 H19.5 L27.5,8.5 V30.5 A3,3 0 0 1 24.5,33.5 H3.5 A3,3 0 0 1 0.5,30.5 Z" />
                        <Path Fill="{Binding (TextElement.Foreground), ElementName=Doc}" Opacity="0.2"
                              Data="M19.5,0.5 V6.5 A2,2 0 0 0 21.5,8.5 H27.5 Z" />
                        <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </Grid>
                    <!-- lucide "folder" -->
                    <Viewbox x:Name="Folder" Width="28" Height="28" Visibility="Collapsed">
                        <Canvas Width="24" Height="24">
                            <Path Fill="{StaticResource FolderTint}" Stroke="{StaticResource FolderInk}" StrokeThickness="1.3"
                                  StrokeLineJoin="Round"
                                  Data="M20,20 A2,2 0 0 0 22,18 V8 A2,2 0 0 0 20,6 H12.1 A2,2 0 0 1 10.41,5.1 L9.6,3.9 A2,2 0 0 0 7.93,3 H4 A2,2 0 0 0 2,5 V18 A2,2 0 0 0 4,20 Z" />
                        </Canvas>
                    </Viewbox>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" LineHeight="20" LineStackingStrategy="BlockLineHeight"
                               Foreground="{StaticResource Primary}" TextTrimming="CharacterEllipsis" />
                    <!-- C:\Users\...\ trims when narrow; the folder holding the file always shows whole -->
                    <local:ShrinkFirstPanel Height="18" Margin="0,2,0,0" ToolTip="{Binding Location}" Background="Transparent">
                        <TextBlock Text="{Binding LocationOuter}" FontSize="12" Foreground="{StaticResource Muted}"
                                   TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding LocationInner}" FontSize="12" Foreground="{StaticResource Secondary}"
                                   VerticalAlignment="Center" />
                    </local:ShrinkFirstPanel>
                </StackPanel>

                <!-- same line heights as the name and path, so size and date sit on their baselines -->
                <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center" MinWidth="72"
                            Typography.NumeralAlignment="Tabular">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Style.Triggers>
                                <!-- a pin keeps the size and date from when it was pinned, so they would be stale -->
                                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="pins">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" FontSize="12"
                               LineHeight="20" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource Secondary}" />
                    <TextBlock Text="{Binding DateText}" HorizontalAlignment="Right" FontSize="12" Margin="0,2,0,0"
                               LineHeight="18" LineStackingStrategy="BlockLineHeight" Foreground="{StaticResource Muted}" />
                </StackPanel>

                <Button Grid.Column="3" Style="{StaticResource PinButton}" Click="Pin_Click" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Size}" Value="{x:Null}">
                    <Setter TargetName="Sheet" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Folder" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

            <StackPanel>
                <Grid Height="56" Margin="16,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!-- lucide "search", 18px, stroke 1.5 -->
                    <Viewbox Width="18" Height="18" Margin="0,0,12,0">
                        <Canvas Width="24" Height="24">
                            <Path Stroke="{StaticResource Muted}" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Data="M11,3 A8,8 0 1 1 11,19 A8,8 0 1 1 11,3 Z M21,21 L16.65,16.65" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock x:Name="Placeholder" Grid.Column="1" Text="搜索 NAS" FontSize="18" Margin="3,0,0,0"
                               Foreground="{StaticResource Muted}" VerticalAlignment="Center" IsHitTestVisible="False" />
                    <TextBox x:Name="Query" Grid.Column="1" FontSize="18" VerticalAlignment="Center"
                             Background="Transparent" BorderThickness="0" Foreground="{StaticResource Primary}"
                             CaretBrush="{StaticResource Accent}" SelectionBrush="{StaticResource Accent}"
                             TextChanged="Query_TextChanged" />
                    <TextBlock x:Name="Status" Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center"
                               MaxWidth="320" TextTrimming="CharacterEllipsis"
                               FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Muted}" />
                </Grid>

                <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                    <Border Height="1" Background="{StaticResource Hairline}" />
                    <ListBox x:Name="Results" MaxHeight="432" Padding="8" Focusable="False"
                             Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ItemContainerStyle="{StaticResource Row}" ItemTemplate="{StaticResource RowTemplate}"
                             PreviewMouseLeftButtonUp="Results_Click" />
                    <Border Height="1" Background="{StaticResource Hairline}" />
                    <StackPanel Orientation="Horizontal" Height="36" Margin="16,0">
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Enter" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="打开" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+Enter" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="打开所在文件夹" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Ctrl+D" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="置顶" Style="{StaticResource Hint}" />
                        <Border Style="{StaticResource Keycap}"><TextBlock Text="Esc" Style="{StaticResource KeyText}" /></Border>
                        <TextBlock Text="关闭" Style="{StaticResource Hint}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
</Window>
