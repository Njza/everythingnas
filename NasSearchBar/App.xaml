<Application x:Class="NasSearchBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- graphite ramp, light values; Theme.cs swaps them for Windows' dark theme, so use them as DynamicResource -->
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Hover" Color="#FAFAFA" />
        <SolidColorBrush x:Key="Raised" Color="#F4F4F5" />
        <SolidColorBrush x:Key="Hairline" Color="#14171717" />
        <SolidColorBrush x:Key="InputLine" Color="#29171717" />
        <SolidColorBrush x:Key="Primary" Color="#171717" />
        <SolidColorBrush x:Key="PrimaryHover" Color="#333333" />
        <SolidColorBrush x:Key="OnPrimary" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Secondary" Color="#525252" />
        <SolidColorBrush x:Key="Muted" Color="#737373" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <SolidColorBrush x:Key="Negative" Color="#DC2626" />
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>

        <!-- the settings window and the bar's format filter -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{DynamicResource Surface}" BorderBrush="{DynamicResource InputLine}" BorderThickness="1">
                                <Path x:Name="Tick" Data="M3.5,7 L6,9.5 L10.5,4.5" Stroke="{DynamicResource OnPrimary}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Muted}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Primary}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Primary}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- one look for every text field (TextBox and PasswordBox both host their text in PART_ContentHost) -->
        <ControlTemplate x:Key="FieldTemplate" TargetType="Control">
            <Border x:Name="B" Height="{TemplateBinding Height}" Padding="8,0" CornerRadius="8" Background="{DynamicResource Surface}"
                    BorderBrush="{DynamicResource InputLine}" BorderThickness="1">
                <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Muted}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Accent}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
        <Style x:Key="Field" TargetType="Control">
            <Setter Property="Height" Value="36" />
            <Setter Property="Template" Value="{StaticResource FieldTemplate}" />
            <Setter Property="Foreground" Value="{DynamicResource Primary}" />
        </Style>
    </Application.Resources>
</Application>
