<Application x:Class="NasSearchBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- graphite light ramp; the only color lives in the file-type tags -->
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Hover" Color="#FAFAFA" />
        <SolidColorBrush x:Key="Raised" Color="#F4F4F5" />
        <SolidColorBrush x:Key="Hairline" Color="#14171717" />
        <SolidColorBrush x:Key="InputLine" Color="#29171717" />
        <SolidColorBrush x:Key="Primary" Color="#171717" />
        <SolidColorBrush x:Key="Secondary" Color="#525252" />
        <SolidColorBrush x:Key="Muted" Color="#737373" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <!-- the settings window and the bar's format filter -->
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" VerticalAlignment="Center"
                                    Background="{StaticResource Surface}" BorderBrush="{StaticResource InputLine}" BorderThickness="1">
                                <Path x:Name="Tick" Data="M3.5,7 L6,9.5 L10.5,4.5" Stroke="White" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed" />
                            </Border>
                            <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Primary}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Primary}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    </Application.Resources>
</Application>
