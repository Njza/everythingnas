<Application x:Class="NasSearchBar.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- graphite light ramp; the only color lives in the file-type tags -->
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
        <SolidColorBrush x:Key="Hover" Color="#FAFAFA" />
        <SolidColorBrush x:Key="Raised" Color="#F4F4F5" />
        <SolidColorBrush x:Key="Hairline" Color="#14171717" />
        <SolidColorBrush x:Key="InputLine" Color="#29171717" />
        <SolidColorBrush x:Key="Primary" Color="#171717" />
        <SolidColorBrush x:Key="Secondary" Color="#525252" />
        <SolidColorBrush x:Key="Muted" Color="#737373" />
        <SolidColorBrush x:Key="Accent" Color="#2563EB" />
        <!-- file sheets: a light tint for the paper, the ink for its outline and extension, by the app that opens it -->
        <SolidColorBrush x:Key="FileTint" Color="#0A171717" />
        <SolidColorBrush x:Key="FileInk" Color="#737373" />
        <SolidColorBrush x:Key="WordTint" Color="#142B579A" />
        <SolidColorBrush x:Key="WordInk" Color="#2B579A" />
        <SolidColorBrush x:Key="ExcelTint" Color="#14217346" />
        <SolidColorBrush x:Key="ExcelInk" Color="#217346" />
        <SolidColorBrush x:Key="PowerPointTint" Color="#14B7472A" />
        <SolidColorBrush x:Key="PowerPointInk" Color="#B7472A" />
        <SolidColorBrush x:Key="PdfTint" Color="#14C42B1C" />
        <SolidColorBrush x:Key="PdfInk" Color="#C42B1C" />
        <!-- manila, like a folder in a filing cabinet -->
        <SolidColorBrush x:Key="FolderTint" Color="#2EE0B04C" />
        <SolidColorBrush x:Key="FolderInk" Color="#9A6F1E" />
        <FontFamily x:Key="Mono">Cascadia Mono, Consolas, Microsoft YaHei UI</FontFamily>
    </Application.Resources>
</Application>
